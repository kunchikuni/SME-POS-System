{
  "name": "wivae",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint resources/js --ext .ts,.tsx",
    "pos:dev": "vite --config pos/vite.config.ts",
    "pos:build": "tsc -p pos/tsconfig.json && vite build --config pos/vite.config.ts",
    "pos:check": "tsc -p pos/tsconfig.json",
    "pos:test": "vitest run --config pos/vitest.config.ts",
    "pos:test:watch": "vitest --config pos/vitest.config.ts",
    "pos:check:test": "tsc -p pos/tsconfig.test.json",
    "build:all": "npm run build && npm run pos:build",
    "server:dev": "npm run dev --workspace=server",
    "server:build": "npm run build --workspace=server",
    "server:start": "npm run start --workspace=server",
    "dev:all": "concurrently -n \"api,dash,pos\" -c \"cyan,magenta,yellow\" \"npm run server:dev\" \"npm run dev\" \"npm run pos:dev\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "jsbarcode": "^3.11.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^2.5.4",
    "update": "^0.7.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
