# Wivae — Node.js API Server Environment
# Copy to .env and fill in real values.
# This is what the API server actually reads at runtime (see repo-root
# .env.example for the separate, smaller file the Prisma CLI reads when
# run from the repo root -- dotenv only loads from the process's cwd, so
# the two can't be merged into one file).

# Server
NODE_ENV=development
PORT=3000

# --- Supabase Postgres ---------------------------------------------------------
# Use the SESSION pooler (port 5432), not the transaction pooler (6543) --
# the transaction pooler breaks Prisma's prepared statements. Prisma's
# `@prisma/adapter-pg` is Postgres-only -- there is no SQLite fallback here
# despite what an older version of this file said.
# Get this from: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> "Session pooler" -> "Prisma" format.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Storage (product images, receipts, white-label branding) ---------
# Server-side only -- see server/src/lib/storage.ts. NEVER add these with a
# VITE_ prefix or reference them from resources/js or pos/src; that would
# ship the service key (full read/write access to every bucket, every
# tenant) straight into the browser bundle.
# Get these from: Supabase dashboard -> Project Settings -> API.
#   SUPABASE_URL           -> "Project URL"
#   SUPABASE_SERVICE_KEY   -> "service_role" key (NOT the "anon" key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Session
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# index.ts refuses to boot in production without a real key here (>=32 chars).
APP_KEY=change-me-to-a-32-character-random-string!!
SESSION_DOMAIN=.wivae.test

# Tenant domain (used by resolveTenant middleware)
TENANT_DOMAIN=wivae.test

# Brand
BRAND_NAME=Wivae

# Redis (for BullMQ workers -- currently an unused dependency; wire this up
# when the rate-limiting / session-store work from AUDIT.md S11 happens)
REDIS_URL=redis://localhost:6379

# --- Email (Resend) -------------------------------------------------------------
# Currently only used for the marketing site's Business/Enterprise enquiry
# form notification (routes/enquiries.ts) -- port of the old
# BusinessEnquiryReceived Mailable. Leave RESEND_API_KEY blank to disable
# gracefully: enquiries still save to the database, the notification email
# is just skipped (logged, not thrown) rather than failing the submission.
# Get an API key from: https://resend.com (free tier covers this comfortably).
RESEND_API_KEY=
EMAIL_FROM=Wivae <notifications@wivae.test>
SALES_EMAIL=

# Paynow (subscription billing)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# ZIMRA FDMS (fiscalisation)
ZIMRA_BASE_URL=https://fdmstest.zimra.co.zw
