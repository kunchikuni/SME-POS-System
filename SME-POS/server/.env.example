# Wivae — Node.js API Server Environment
# Copy to .env and fill in real values.
# This is what the API server actually reads at runtime (see repo-root
# .env.example for the separate, smaller file the Prisma CLI reads when
# run from the repo root -- dotenv only loads from the process's cwd, so
# the two can't be merged into one file).

# Server
NODE_ENV=development
PORT=3000

# --- Supabase Postgres ---------------------------------------------------------
# Use the SESSION pooler (port 5432), not the transaction pooler (6543) --
# the transaction pooler breaks Prisma's prepared statements. Prisma's
# `@prisma/adapter-pg` is Postgres-only -- there is no SQLite fallback here
# despite what an older version of this file said.
# Get this from: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> "Session pooler" -> "Prisma" format.
#
# The "aws-0-" / "aws-1-" prefix varies per project -- copy it exactly from
# your own dashboard, don't assume aws-0.
#
# The two query params are not optional extras -- without them, expect
# P1001 ("can't reach database server") or TLS SELF_SIGNED_CERT_IN_CHAIN on
# Windows machines running antivirus that intercepts TLS (very common; Node
# doesn't read the Windows certificate store the way browsers do). If
# db push/seed is still flaky after adding these, also try
# &connect_timeout=30 -- the antivirus inspection adds real handshake
# latency that can exceed Prisma's default connect timeout.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-X-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true

# --- Supabase Storage (product images, receipts, white-label branding) ---------
# Server-side only -- see server/src/lib/storage.ts. NEVER add these with a
# VITE_ prefix or reference them from resources/js or pos/src; that would
# ship the service key (full read/write access to every bucket, every
# tenant) straight into the browser bundle.
# Get these from: Supabase dashboard -> Project Settings -> API.
#   SUPABASE_URL           -> "Project URL"
#   SUPABASE_SERVICE_KEY   -> "service_role" key (NOT the "anon" key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Session
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# index.ts refuses to boot in production without a real key here (>=32 chars).
APP_KEY=change-me-to-a-32-character-random-string!!
# Dev: leave unset (browsers refuse a ".localhost" cookie; each workspace gets
# its own session). Production: ".yourdomain.com".
# SESSION_DOMAIN=

# Tenant domain (used by resolveTenant middleware)
# Dev: "localhost" — every <workspace>.localhost reaches this machine with no
# hosts-file edits, and counts as a secure context (PWA install works).
# Production: your real root domain, e.g. wivae.com.
TENANT_DOMAIN=localhost

# Brand
BRAND_NAME=Wivae

# Redis (for BullMQ workers -- currently an unused dependency; wire this up
# when the rate-limiting / session-store work from AUDIT.md S11 happens)
REDIS_URL=redis://localhost:6379

# --- Email (Resend) -------------------------------------------------------------
# Currently only used for the marketing site's Business/Enterprise enquiry
# form notification (routes/enquiries.ts) -- port of the old
# BusinessEnquiryReceived Mailable. Leave RESEND_API_KEY blank to disable
# gracefully: enquiries still save to the database, the notification email
# is just skipped (logged, not thrown) rather than failing the submission.
# Get an API key from: https://resend.com (free tier covers this comfortably).
RESEND_API_KEY=
EMAIL_FROM=Wivae <notifications@wivae.test>
SALES_EMAIL=

# Billing reminder emails (domain/billing/reminders.ts): owners are emailed 5 days
# before, 1 day before, when their trial / paid period ends, and when their tills
# pause. Paynow cannot charge again by itself, so this is what stops owners
# forgetting to pay. OFF unless set to "on" (and RESEND_API_KEY is set) -- leave it
# off against a development database so test businesses are never emailed.
# TENANT_DOMAIN and APP_SCHEME build the pay link in the email and text.
BILLING_REMINDERS=off

# --- SMS (billing reminders by text) --------------------------------------------
# Owners who give a mobile number (at sign-up or in Settings > Account) are also
# texted from the day before a payment is due. Leave blank to send email only.
# Twilio is the one provider wired up (lib/sms.ts); it is NOT the cheap choice
# for Zimbabwe (roughly $0.20 a message vs $0.02-0.06 from local gateways), so a
# local gateway is worth an adapter once you pick one.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sender: a Twilio number, or an approved alphanumeric sender ID...
TWILIO_FROM=
# ...or a Messaging Service instead of TWILIO_FROM.
TWILIO_MESSAGING_SERVICE_SID=

# Paynow (subscription billing)
# Get these from Paynow: My Integrations -> your integration -> Integration ID / Key.
# https://developers.paynow.co.zw/docs/quickstart.html
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Used to build the return/result URLs sent to Paynow (billing.ts) --
# defaults to https for production. Only override to http for local dev
# against a plain http:// tunnel (Paynow's servers can't reach localhost
# directly either way -- needs ngrok or similar to actually test locally).
APP_SCHEME=https

# ZIMRA FDMS (fiscalisation)
ZIMRA_BASE_URL=https://fdmstest.zimra.co.zw
